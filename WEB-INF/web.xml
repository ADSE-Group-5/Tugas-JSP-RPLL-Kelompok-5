<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Tugas JSP dan Servlet</display-name>

    <!-- Servlet untuk Persegi Panjang (Soal 1 & 2) -->
    <servlet>
        <servlet-name>PersegiPanjangServlet</servlet-name>
        <servlet-class>com.tugas.servlet.PersegiPanjangServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PersegiPanjangServlet</servlet-name>
        <url-pattern>/HitungPersegiPanjang</url-pattern>
    </servlet-mapping>

    <!-- Servlet untuk Persamaan Kuadrat (Soal 3) -->
    <servlet>
        <servlet-name>PersamaanKuadratServlet</servlet-name>
        <servlet-class>com.tugas.servlet.PersamaanKuadratServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PersamaanKuadratServlet</servlet-name>
        <url-pattern>/HitungPersamaanKuadrat</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
